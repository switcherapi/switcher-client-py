[run]
branch = True
source = switcher_client
omit =
    switcher_client/lib/utils/timed_match/worker.py
    switcher_client/lib/compat.py,
    switcher_client/version.py,
    */tests/*
    */test_*

[report]
fail_under = 98
show_missing = True
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError